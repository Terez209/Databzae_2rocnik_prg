<Window x:Class="databzae_hry.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Evidence her" Height="600" Width="1000"
        MinHeight="500" MinWidth="800">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" />
            <ColumnDefinition Width="2*" />
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Grid.Column="0" Grid.Row="0" VerticalAlignment="Center" Margin="0,0,0,8">
            <TextBlock Text="Hledat (podle názvu):" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox Width="250" Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}" />
            <Button Content="Vyčistit" Margin="8,0,0,0" Command="{Binding ClearFilterCommand}" />
            <StackPanel Orientation="Horizontal" Margin="16,0,0,0">
                <Button Content="Přidat..." Command="{Binding OpenAddDialogCommand}" Margin="0,0,6,0"/>
                <Button Content="Upravit vybrané" Command="{Binding EditSelectedCommand}" Margin="0,0,6,0" />
                <Button Content="Smazat vybrané" Command="{Binding DeleteSelectedCommand}" />
            </StackPanel>
        </StackPanel>

        <DataGrid Grid.Column="0" Grid.Row="1" ItemsSource="{Binding GamesView}" AutoGenerateColumns="False"
                  SelectionMode="Single" SelectedItem="{Binding SelectedHra, Mode=TwoWay}"
                  CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Název" Binding="{Binding Jmeno}" Width="*" />
                <DataGridTextColumn Header="Autor (studio)" Binding="{Binding Autor}" Width="200" />
                <DataGridTextColumn Header="Rok vydání" Binding="{Binding RokVydani}" Width="110" />
                <DataGridTextColumn Header="Žánr" Binding="{Binding Zanr}" Width="140" />
                <DataGridCheckBoxColumn Header="Staženo" Binding="{Binding Instalovana}" Width="90" />

                <DataGridTemplateColumn Header="Akce" Width="140">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Content="Upravit" Margin="2,0" Padding="6,2"
                                        Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}" />
                                <Button Content="Smazat" Margin="2,0" Padding="6,2"
                                        Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Column="1" Grid.Row="0" Grid.RowSpan="3" Margin="12,0,0,0" Padding="10" BorderBrush="#DDD" BorderThickness="1" CornerRadius="4">
            <StackPanel>
                <TextBlock Text="Formulář hry" FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>

                <TextBlock Text="Název:"/>
                <TextBox Text="{Binding NewJmeno, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Text="Autor (studio):" Margin="0,6,0,0"/>
                <TextBox Text="{Binding NewAutor, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Text="Rok vydání:" Margin="0,6,0,0"/>
                <TextBox Text="{Binding NewRok, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Text="Žánr:" Margin="0,6,0,0"/>
                <TextBox Text="{Binding NewZanr, UpdateSourceTrigger=PropertyChanged}" />

                <CheckBox Content="Staženo" IsChecked="{Binding NewInstalovana}" Margin="0,6,0,0"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,12,0,0">
                    <Button Content="Přidat hru" Width="100" Command="{Binding AddCommand}" />
                    <Button Content="Uložit změny" Width="110" Margin="8,0,0,0" Command="{Binding SaveEditCommand}" />
                    <Button Content="Zrušit edit" Width="100" Margin="8,0,0,0" Command="{Binding CancelEditCommand}" />
                </StackPanel>

                <Separator Margin="0,12,0,12"/>

                <TextBlock Text="Detaily vybrané hry:" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <StackPanel>
                    <TextBlock Text="{Binding SelectedHra.Jmeno, TargetNullValue='-'}" FontWeight="Bold"/>
                    <TextBlock Text="{Binding SelectedHra.Autor, TargetNullValue='-'}" />
                    <TextBlock Text="{Binding SelectedHra.RokVydani, TargetNullValue='-'}" />
                    <TextBlock Text="{Binding SelectedHra.Zanr, TargetNullValue='-'}" />
                    <TextBlock>
                        <Run Text="Staženo: "/>
                        <Run Text="{Binding SelectedHra.Instalovana}" />
                    </TextBlock>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>